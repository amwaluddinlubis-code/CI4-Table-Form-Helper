{
    "name": "amwaluddinlubis/ci4-tabel-form-helper",
    "description": "Helper tabel daftar dan form modal CRUD untuk CodeIgniter 4: tabel_bantu() + form_modal() + crud_bantu() dari konfigurasi, lengkap dengan paginasi/pencarian tabel, select searchable, isian tanggal dd-mm-yyyy, dan field uang.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "email": "amwaluddin.lubis@gmail.com",
            "name": "Amwaluddin Lubis"
        }
    ],
    "require": {
        "codeigniter4/framework": "^4.0",
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ci4TabelForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ci4TabelForm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
